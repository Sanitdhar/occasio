{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@occasio/core": ["../../packages/core/src/index.ts"],
      "@occasio/core/*": ["../../packages/core/src/*"],
      "@occasio/theme": ["../../packages/theme/src/index.ts"],
      "@occasio/theme/*": ["../../packages/theme/src/*"],
      "@occasio/data": ["../../packages/data/src/index.ts"],
      "@occasio/data/*": ["../../packages/data/src/*"],
      "@occasio/ui": ["../../packages/ui/src/index.ts"],
      "@occasio/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
